# Environment Variables for FraudGuard Backend

# Flask Configuration
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# API Keys
IP_GEOLOCATION_API_KEY=your_ip_geolocation_api_key_here
CITY_POPULATION_API_KEY=your_city_population_api_key_here

# Firebase
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Fraud Detection Settings
FRAUD_THRESHOLD=0.4
CARD_VELOCITY_TIME_WINDOW=10
CARD_VELOCITY_MAX_TRANSACTIONS=2
